# GEMINI_API_KEY: Required for Gemini AI text matching (triggerAIMatching).
GEMINI_API_KEY=""

# Hermes Agent CLI path for image matching.
# The Node server calls this CLI to analyze uploaded images visually.
HERMES_CLI="/opt/hermes/.venv/bin/hermes"
HERMES_MATCH_TIMEOUT_MS="60000"

# Cloudinary storage for uploaded item/proof images.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# DATABASE_PATH: SQLite database file used by the Express backend.
DATABASE_PATH="./database.sqlite"

# DATABASE_URL: Postgres connection string (optional, for production).
# DATABASE_URL="postgresql://..."

# JWT_SECRET: Change this before production.
JWT_SECRET="change-this-secret"

# Google OAuth / Gmail sign-in.
# Use the same OAuth Web client ID for the browser build and the API verifier.
# In Google Cloud Console, add your deployed Vercel URL to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
